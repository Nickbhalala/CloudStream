# Copy to .env. Never commit .env.
# Used by the producer and query scripts against a deployed stack.
# Credentials come from your AWS profile / SSO session, not from this file.
AWS_REGION=us-east-1
AWS_PROFILE=
CLOUDSTREAM_STREAM=cloudstream-events
CLOUDSTREAM_AGG_TABLE=cloudstream-aggregates
CLOUDSTREAM_DEDUPE_TABLE=cloudstream-dedupe
CLOUDSTREAM_DLQ_URL=
